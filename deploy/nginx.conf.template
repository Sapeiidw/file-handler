worker_processes 2;
pid __ROOT__/data/nginx.pid;
error_log __ROOT__/data/nginx-error.log warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log __ROOT__/data/nginx-access.log;
    client_body_temp_path __ROOT__/data/nginx-tmp;
    proxy_temp_path __ROOT__/data/nginx-proxy;
    fastcgi_temp_path __ROOT__/data/nginx-fastcgi;
    uwsgi_temp_path __ROOT__/data/nginx-uwsgi;
    scgi_temp_path __ROOT__/data/nginx-scgi;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 30;
    server_tokens off;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;
    limit_req_zone $binary_remote_addr zone=api:10m rate=15r/s;
    limit_conn_zone $binary_remote_addr zone=connections:10m;
    server {
        listen 127.0.0.1:8088;
        server_name file-handler.local localhost 127.0.0.1;
        root __ROOT__/dist;
        index index.html;
        client_max_body_size 52m;
        client_body_timeout 60s;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        location /api/ {
            limit_req zone=api burst=40 nodelay;
            limit_req_status 429;
            limit_conn connections 20;
            proxy_pass http://127.0.0.1:8788;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
            proxy_request_buffering on;
            proxy_buffering off;
        }
        location /assets/ {
            expires 1y;
            try_files $uri =404;
        }
        location / {
            expires -1;
            try_files $uri $uri/ /index.html;
        }
    }
}
