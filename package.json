{
  "name": "file-handler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "build": "node scripts/copy-docs.mjs && tsc --noEmit && vite build --config frontend/vite.config.ts",
    "test": ".venv/bin/python -m pytest tests -q",
    "lint": "eslint frontend/src && .venv/bin/ruff check backend scripts tests",
    "format": "prettier --write frontend/src frontend/vite.config.ts frontend/index.html package.json tsconfig.json eslint.config.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.9.10",
    "swagger-ui-dist": "^5.34.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
